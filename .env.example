# Claude API キー（未設定でも動きます。その場合はAIを使わない「簡易レポート」になります）
ANTHROPIC_API_KEY=

# 使用するモデル（既定: claude-opus-5-5）。費用を抑えたい場合は claude-haiku-5-5 も指定できます
CLAUDE_MODEL=claude-opus-5-5

# Google PageSpeed Insights API キー（任意。無いと無料枠が少なく、速度計測が失敗しやすい）
PAGESPEED_API_KEY=

# AIレポートの1日あたりの上限回数（サーバー全体）。API料金の使いすぎ防止
DAILY_AI_LIMIT=30
